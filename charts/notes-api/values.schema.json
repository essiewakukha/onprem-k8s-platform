{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "notes-api values",
  "type": "object",
  "required": ["replicaCount", "image", "rollout", "persistence"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "digest": { "type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "rollout": {
      "type": "object",
      "properties": {
        "maxSurge": { "type": ["integer", "string"] },
        "maxUnavailable": { "type": ["integer", "string"] },
        "minReadySeconds": { "type": "integer", "minimum": 0 },
        "progressDeadlineSeconds": { "type": "integer", "minimum": 30 }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "accessMode": { "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod"] },
        "size": { "type": "string", "pattern": "^[0-9]+(Mi|Gi|Ti)$" }
      }
    },
    "nodeFailure": {
      "type": "object",
      "properties": {
        "tolerationSeconds": { "type": "integer", "minimum": 0, "maximum": 300 }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "host": { "type": "string" }
      }
    }
  }
}